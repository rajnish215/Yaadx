# Server only. Copy outside the repository; never put these in Flutter --dart-define.
DATABASE_URL=postgresql://runtime_user:REPLACE@YOUR-ENDPOINT-pooler.YOUR-REGION.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://migration_user:REPLACE@YOUR-ENDPOINT.YOUR-REGION.aws.neon.tech/neondb?sslmode=verify-full
DB_SCHEMA=yaadx_dev
FIREBASE_PROJECT_ID=yaadx-8e018
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Production: use workload identity/Application Default Credentials, or a secret-mounted
# GOOGLE_APPLICATION_CREDENTIALS file outside this repository. Never bundle it in APK.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# Optional private S3-compatible storage. AWS credentials are server-only.
# S3_BUCKET=yaadx-private-media
# AWS_REGION=YOUR_REGION
# S3_ENDPOINT=https://YOUR_STORAGE_ENDPOINT
# AWS_ACCESS_KEY_ID=REPLACE
# AWS_SECRET_ACCESS_KEY=REPLACE
# S3_PATH_STYLE=false
# Optional AI wishes/gift suggestions. Server-only; no key in Flutter.
# Choose a currently supported Gemini model with structured JSON output.
# GEMINI_API_KEY=REPLACE
# GEMINI_MODEL=YOUR_SUPPORTED_MODEL_ID

# Comma-separated exact Firebase emails; authenticated by Firebase.
# Admin access is denied when empty. Never use a browser-only allowlist.
ADMIN_EMAILS=
